// Set LibreWolf PiP to floating by default
window-rule {
  match app-id=r#"librewolf$"# title="^Picture-in-Picture$"
  open-floating true
}

// Enable blur for Alacritty
window-rule {
  match app-id="^Alacritty$"

  background-effect {
    blur true
  }
}

// Block password managers from screen capture
window-rule {
  match title="Bitwarden"
  match title="Password"

  block-out-from "screen-capture"
}

window-rule {
  match title="Bitwarden"
  open-floating true
}

// Rounded corners
window-rule {
  geometry-corner-radius 15
  clip-to-geometry true
}

// Floating Noctalia settings window
window-rule {
  match app-id="dev.noctalia.Noctalia"
  open-floating true
  default-column-width { fixed 1080; }
  default-window-height { fixed 920; }
}

// Noctalia overview backdrop
layer-rule {
	match namespace="^noctalia-backdrop"
	place-within-backdrop true
}

// Remove the background that borders draw
// so that transparent windows aren't tinted
window-rule {
  draw-border-with-background false
}

// Make Steam notifications show up in the bottom right, and not focus
window-rule {
  match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
  default-floating-position x=10 y=10 relative-to="bottom-right"
  open-focused false
}
